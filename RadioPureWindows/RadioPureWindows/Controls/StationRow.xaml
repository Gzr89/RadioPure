<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RadioPureWindows.Controls.StationRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20,12" Background="Transparent">
        <Border x:Name="HoverBackground" Background="#0DFFFFFF" Opacity="0" />
        <Rectangle
            VerticalAlignment="Bottom"
            Height="1"
            Margin="60,0,0,0"
            Fill="#12FFFFFF" />

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="IconBackground"
                Width="40"
                Height="40"
                CornerRadius="10">
                <TextBlock
                    x:Name="EmojiText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="18" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="NameText" FontSize="16" Foreground="White" />
                <TextBlock x:Name="SubtitleText" FontSize="12" />
            </StackPanel>

            <FontIcon
                x:Name="StatusIcon"
                Grid.Column="2"
                FontSize="16"
                Visibility="Collapsed" />
            <FontIcon
                x:Name="ChevronIcon"
                Grid.Column="2"
                FontSize="12"
                Glyph="&#xE76C;"
                Foreground="#33FFFFFF"
                Visibility="Visible" />
        </Grid>
    </Grid>
</UserControl>
